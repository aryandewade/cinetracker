# TMDB API Key (v3 auth)
# Get your free key by registering at https://www.themoviedb.org/
VITE_TMDB_API_KEY=your_api_key_here

# Secret used to sign JWTs by the local API server (required) — generate with: openssl rand -base64 32
JWT_SECRET=replace_with_a_long_random_secret
# Browser origin allowed to call the local API server
CORS_ORIGIN=http://localhost:5173
